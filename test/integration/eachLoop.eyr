fn main [-> Int] f{
   coll = [1 2 3 4];
   
   print `forwards`;
   each { coll ->
      print coll.@;
   }
   print `backwards`;
   each { coll step -1 ->
      print coll.@;
   }
   print `skip 2`;
   each { coll skip 2 ->
      print coll.@;
   }
   print `balk 1`;
   each { coll balk 1 ->
      print coll.@;
   }
   print `skip 1 balk 2`;
   each { coll skip 1 balk 2 ->
      print coll.@;
   }
   print `skip 1 step -1 balk 2`;
   each { coll skip 1 step -1 balk 1 ->
      print coll.@;
   }
   print `nested`;
   strings = [`A` `B`];
   each { strings ->
      each { coll skip 1 step 2 ->
         print strings.@;
         print coll.#;
      }
   } 
   
   return 0;
}



fn conditionalPrinter [Int->] f{x ->
   print `foo:`;
   if x < 800 {
      print `less than 800`;
   } ei x == 800 {
      print `== 800`;
   } else {
      print `greater than 800`;
   }
}

fn main [-> Int] f{
   (conditionalPrinter 799);
   (conditionalPrinter 800);
   (conditionalPrinter 801);
   return 0;
}

////EXPECTED{
//foo:
//less than 800
//foo:
//== 800
//foo:
//greater than 800
////}

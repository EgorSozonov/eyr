fn fizzBuzz f{
    for {i' = 1; i < 101; i++; }{
        worker i;
    }
}

fn worker [Int ->] { i ->
    if i % 3 == 0 && (i % 5 == 0) {print `FizzBuzz`;}
    ei i % 3 == 0 { print `Fizz`; }
    ei i % 5 == 0 { print `Buzz`; }
    else          { print i; }
}

fn main [ -> Int] {
    (fizzBuzz);
    return 0;
}

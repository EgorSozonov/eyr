fn main F(->Int) = f{->
    (sortingIntArrays);
    (sortingStringArrays);
    return 0;
};

fn swap F(Int Int (L $E) ->) = f{ i j arr ->
    tmp = arr[i];
    arr[i] = arr[j];
    arr[j] = tmp;
};

fn insertionSort F((L $E) F($E $E Int) ->) = f{ arr comparer -> 
    for {i' = 0; i < #arr; i++; }{
       for {j' = i + 1; j < #arr; j++; }{
          if comparer arr[i] arr[j] > 0 {
             swap i j arr;
          }
       }
    } 
};

fn ascending F(Int Int -> Int) = f{ a b ->
   return a - b;
};

fn descending F(Int Int -> Int) = f{ a b ->
   return b - a;
};

fn ascending F(Str Str -> Int) = f{ a b ->
   return #a - #b;
};

fn descending F(Str Str -> Int) = f{ a b ->
   return #b - #a;
};


fn print F((L $E) ->) = f{ lst ->
    print `[`;
    for {i' = 0; i < #lst; i++;}{
        print lst[i];
    } 
    print `]`;
};

fn sortingIntArrays F(->) = f{->
   leArray = [5 1 2 4 3];
   print `Unsorted:`;
   print leArray;
   sorter' F Int Int Int = ascending;
   insertionSort leArray sorter;
   print `Sorted ASC:`;
   print leArray;
   
   sorter = descending;
   insertionSort leArray sorter;
   print `Sorted DESC:`;
   print leArray;
};

fn sortingStringArrays F(->) = f{->
   leArray = [`already` `some` `Get` `sleep`];
   print `Unsorted:`;
   print leArray;
   sorter' F Str Str Int = ascending;
   insertionSort leArray sorter;
   print `Sorted ASC:`;
   print leArray;
   
   sorter = descending;
   insertionSort leArray sorter;
   print `Sorted DESC:`;
   print leArray;
};


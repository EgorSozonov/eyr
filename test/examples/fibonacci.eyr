def fibonacci Int = {{ n Int, }
     if  n <= 0 { return 0; }
     eif n == 1 { return 1; }

     accum' = 1;
     for { beforeLast' = 0; swap' = 0; k' = n - 1;
           k > 0; k--;
         }{
          swap = beforeLast;
          beforeLast = accum;
          accum += swap;
     }
     return accum;
};

def main = {{}
    print `First 10 Fibonacci numbers:`;
    for { k' = 0; k < 10; k++; } {
       print (fibonacci k);
    }
};

fn multiply [[A [A Int]] [A [A Int]] -> [A [A Int]]] f{
   a b ->
   rows = a.len;
   cols = b[0].len;
   middle = a[0].len; // == b.len but we don't validate
   res = [@[A Int] rows];
   for {i' = 0; i < rows; i++; } {
      aRow [A Int] = a[i];
      newRow = [@Int cols];
      for {j' = 0; j < cols; j++; } {
         elt' = 0;
         for {k' = 0; k < middle; k++; } {
            elt += aRow[k] * b[k][j];
         }
         newRow[j] = elt;
      }
      res[i] = newRow;
   }
   return res;
}

fn main [-> Int] f{
   a [A [A Int]] = [[1 2 3 4 5] [10 9 8 7 6]];
   b [A [A Int]] = [[10] [10] [10] [10] [10]];
   product = multiply a b;
   print `[`; 
   for { i' = 0; i < product.len; i++; } {
      print `[`; 
      for {j' = 0; j < product[0].len; j++; } {
         print product[i][j]; 
      }
      print `]`; 
   }
   print `]`; 
   return 0;
}


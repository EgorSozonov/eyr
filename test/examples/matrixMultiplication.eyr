fn multiply F((L (L Int)) (L (L Int)) -> (L (L Int)) = f{a b ->
   rows = a.len;
   cols = b[0].len;
   middle = a[0].len;
   res L (L Int) = [];
   for {i' = 0; i < rows; i++; } {
      rw L Int = a[i];
      newRow L Int = [];
      for {j' = 0; j < cols; j++; } {
         elt' = 0;
         for {k' = 0; k < middle; k++; } {
            elt += rw[k] * b[k][j];
         }
         add newRow elt;
      }
      add res newRow;
   }
   return res;
};

fn main F(-> Int) = f{->
   a (L (L Int)) = [[1 2 3 4 5] [10 9 8 7 6]];
   b (L (L Int)) = [[10] [10] [10] [10] [10]];
   product = multiply a b;
   print `[`; 
   for { i' = 0; i < product.len; i++; } {
      print `[`; 
      for {j' = 0; j < product[0].len; j++; } {
         print product[i][j]; 
      }
      print `]`; 
   }
   print `]`; 
   return 0;
};
